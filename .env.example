# Runtime mode and API binding. These stay env-at-boot and still need a restart.
THYTRADER_ENVIRONMENT=development
THYTRADER_API_HOST=127.0.0.1
THYTRADER_API_PORT=8200
# Reserved for a future authenticated remote-access mode; setting true does not permit LAN binding.
THYTRADER_ALLOW_REMOTE_ACCESS=false

# Optional override for the YAML non-secret settings file (default thytrader.yaml).
# THYTRADER_SETTINGS_FILE=thytrader.yaml

# Shared credentials directory for installation token and Coinbase dotenv (Compose volume).
# THYTRADER_CREDENTIALS_DIR=.thytrader-credentials
# Optional explicit installation token; otherwise generated on first API boot in production.
# THYTRADER_INSTALLATION_TOKEN=

# Coinbase Advanced Trade credentials remain server-side.
# Leave both empty to use demo data. View + Trade and keys with extra permissions are accepted.
# Preserve PEM newlines with a quoted value using \n escapes when your shell requires it.
THYTRADER_COINBASE_API_KEY_NAME=
THYTRADER_COINBASE_API_PRIVATE_KEY=

# PostgreSQL persistence is optional. Leave blank/absent to disable durable history.
# For clone-friendly local setup, run:
#   uv run python scripts/setup_local_stack.py
# It writes matching local-only settings into this ignored .env file, starts
# PostgreSQL, applies migrations, then starts the API, workers, and web UI.
# Never commit a real database URL or password.
THYTRADER_DATABASE_URL=

# Dataset root stays env-at-boot (restart required). Intervals, lookback, and the
# default ingest product live in thytrader.yaml and apply without restart.
THYTRADER_MARKET_DATA_DATASET_ROOT=data/market-data

# Research worker pool (ADR 0092), env-at-boot. The research-worker service is the only
# process that runs backtests, studies, and portfolio backtests; each worker process runs
# one job at a time. 2 workers are memory-safe on an 8 GB host.
# THYTRADER_RESEARCH_WORKER_COUNT=2
# THYTRADER_RESEARCH_WORKER_MAX_JOBS=50
# THYTRADER_RESEARCH_WORKER_MAX_RSS_GROWTH_MB=256
# THYTRADER_RESEARCH_JOB_LEASE_SECONDS=60
# THYTRADER_RESEARCH_JOB_MAX_ATTEMPTS=3
# How long a synchronous research submit waits in the API before answering HTTP 202.
# THYTRADER_RESEARCH_SYNC_WAIT_SECONDS=25

# Non-secret knobs (YOLO on/off + independent tiers, log level, snapshot/market-data/
# execution intervals, lookback, default product, notify provider) live in
# thytrader.yaml and win leftover env. Secrets never go in YAML.
# Leftover THYTRADER_YOLO_TIERS=paper is valid (not JSON). Compose must not inject
# an empty THYTRADER_YOLO_TIERS= that JSON-decodes. YAML `yolo.tiers: paper` is
# also valid. Live still requires --i-understand-live. Playbook never starts live.
# Notify webhook URL stays here; notify_provider is YAML.
THYTRADER_NOTIFY_WEBHOOK_URL=
